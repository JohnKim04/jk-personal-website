# Copy this file to .env.local only when the site needs configuration.
# Never put secrets in a NEXT_PUBLIC_ variable: those values are sent to browsers.
# Keep real values in .env.local, which is ignored by Git.
# Add the final HTTPS origin once it is selected so metadata, sitemap, and robots
# use absolute production URLs. Use only the origin: no path, query, hash, or credentials.
# SITE_URL=https://your-domain.com
